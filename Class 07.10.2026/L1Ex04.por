programa {
  funcao inicio() {
    inteiro nota

    escreva("Nota:\n")
    leia(nota)

    escolha (nota){
    caso 10: escreva("Excelente")
    pare
    caso 9: escreva("Excelente") 
    pare
    caso 8: escreva("Muito bom")
    pare
    caso 7:  escreva("Bom")
    pare
    caso 6: escreva("Regular")
    pare
    caso 5:  escreva("Recuperação")
    pare
    caso 4: escreva("Reprovado")
    pare
    caso 3: escreva("Reprovado")
    pare
    caso 2: escreva("Reprovado")
    pare
    caso 1: escreva("Reprovado")
    pare
    caso 0: escreva("Reprovado")
    }
  }
}