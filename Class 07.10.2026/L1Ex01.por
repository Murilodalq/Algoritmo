programa {
  funcao inicio() {
    
    inteiro numero

    escreva("Digite o dia da semana (1-7):")
    leia(numero)

    escolha (numero){
      caso 1: 
      escreva("Segunda")
      pare
      caso 2: 
      escreva("Terça")
      pare
      caso 3: 
      escreva("Quarta")
      pare
      caso 4: 
      escreva("Quinta")
      pare
      caso 5: 
      escreva("Sexta")
      pare
      caso 6: 
      escreva("Sabado")
      pare
      caso 7: 
      escreva("Domingo")
      pare
      caso contrario: 
      escreva("INVALIDO")

    }
  }
}