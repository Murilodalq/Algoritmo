programa {
  funcao inicio() {
    real num1, num2, num3, media
    escreva("Digite a primeira nota:\n")
    leia(num1)
    escreva("Digite a segunda nota:\n")
    leia(num2)
    escreva("Digite a terceita nota:\n")
    leia(num3)
    
    media = (num1 + num2 + num3) / 3

    escreva("A média é: ", media)
  }
}
